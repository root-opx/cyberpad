<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Uninstall.exe: a small WinForms program on the .NET Framework that ships with Windows (net471), so it
    needs no runtime bundled. No package of any kind; it builds against the 4.7.1 developer pack.
    The logic is in CyberPad.Install.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net471</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>Uninstall</AssemblyName>
    <RootNamespace>CyberPad.Uninstall</RootNamespace>
    <ApplicationIcon>..\CyberPad.Desktop\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CyberPad.Install\CyberPad.Install.csproj" Private="false" />
    <Compile Include="..\Shared\UiCommon.cs" Link="Shared\UiCommon.cs" />
    <Compile Include="..\Shared\EmbeddedLibrary.cs" Link="Shared\EmbeddedLibrary.cs" />
  </ItemGroup>

  <!-- One file, no loose DLL: the library is embedded and loaded by Shared\EmbeddedLibrary.cs. -->
  <Target Name="EmbedInstallLibrary" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <EmbeddedResource Include="@(_ResolvedProjectReferencePaths)" Condition="'%(Filename)' == 'CyberPad.Install'" LogicalName="CyberPad.Install.dll" />
    </ItemGroup>
  </Target>

</Project>
