<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Uninstall.exe: a small WinForms program on the .NET Framework that ships with Windows (net471), so it
    needs no runtime bundled. No package of any kind; it builds against the 4.7.1 developer pack.
    The logic is CyberPad.Install's source, compiled in (see below).
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net471</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>Uninstall</AssemblyName>
    <RootNamespace>CyberPad.Uninstall</RootNamespace>
    <ApplicationIcon>..\CyberPad.Desktop\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.1.0</Version>
    <IsPackable>false</IsPackable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The library's source files are compiled into this program, so it loads no CyberPad DLL at run time:
      nothing placed next to the exe (for example in Downloads) can stand in for it.
    -->
    <Compile Include="..\CyberPad.Install\*.cs" Link="Install\%(Filename)%(Extension)" />
    <Compile Include="..\Shared\UiCommon.cs" Link="Shared\UiCommon.cs" />
    <Compile Include="..\Shared\ProcessGuard.cs" Link="Shared\ProcessGuard.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

</Project>
